# ============================================
# Agente Autônomo de Vagas — Template de Configuração
# Renomeie este arquivo para .env e preencha suas chaves
# ============================================

# Seu e-mail (Gmail) para envio e recebimento dos relatórios
MEU_EMAIL=seu_email@gmail.com

# Senha de App do Gmail (não é a senha normal da sua conta!)
# Gere em: https://myaccount.google.com/apppasswords
SENHA_APP=sua_senha_de_app_aqui

# Chave da API do Google Gemini
# Gere gratuitamente em: https://aistudio.google.com/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# Telefone de contato para preenchimento de candidaturas (opcional)
MEU_TELEFONE=(11) 99999-9999

# Credenciais do LinkedIn para login automático (opcional)
LINKEDIN_EMAIL=seu_email_linkedin@gmail.com
LINKEDIN_SENHA=sua_senha_linkedin
